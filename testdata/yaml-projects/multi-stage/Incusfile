version: 1
name: yaml-multi-stage
network: nat
stages:
  - name: build
    from: alpine/3.24
    steps:
      - workdir: /src
      - copy:
          sources: [main.sh]
          destination: ./
      - exec:
          command: chmod
          args: ["0755", main.sh]
      - exec:
          command: ./main.sh
          args: []
  - from: alpine/3.24
    steps:
      - copy:
          from: build
          sources: [/src/result.txt]
          destination: /result.txt
