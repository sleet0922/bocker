version: 2
name: yaml-multi-stage
network: nat
stages:
  - name: build
    from: alpine/3.24
    workdir: /src
    files: {./: [main.sh]}
    commands:
      - shell: |
          set -eu
          chmod 0755 main.sh
          ./main.sh
  - from: alpine/3.24
    artifacts: {build: {/src/result.txt: /result.txt}}
