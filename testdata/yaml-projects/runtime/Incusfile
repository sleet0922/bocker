version: 2
name: yaml-runtime
network: nat
stages:
  - from: alpine/3.24
    env: {APP_ENV: production}
    commands: [[mkdir, -p, /opt/yaml-runtime/logs]]
    runtime:
      entrypoint: [/bin/sh]
      cmd: [-c, "printf '%s\\n' \\\"$APP_ENV\\\""]
      expose: [8080]
      domain: yaml-runtime.test
      autostart: false
