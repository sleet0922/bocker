version: 2
name: yaml-runtime
network: nat
stages:
  - from: alpine/3.24
    env: {APP_ENV: production}
    commands: [[mkdir, -p, /opt/yaml-runtime/logs]]
    runtime:
      entrypoint: [/bin/sh]
      cmd: [-c, "printf '%s\\n' \\\"$APP_ENV\\\""]
      expose: [8080]
      mounts:
        - {source: ./runtime-data, target: /opt/yaml-runtime/data, mode: rw}
        - {source: ./runtime-message.txt, target: /opt/yaml-runtime/message.txt, readonly: true}
      domain: yaml-runtime.test
      autostart: false
