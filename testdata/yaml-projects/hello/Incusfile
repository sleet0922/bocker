version: 2
name: yaml-hello
network: nat
stages:
  - name: builder
    from: alpine/3.24
    workdir: /src
    files: {./: [hello.sh, message.txt]}
    commands:
      - shell: |
          set -eu
          chmod 0755 hello.sh
          ./hello.sh "$(cat message.txt)" > /out.txt
  - from: alpine/3.24
    artifacts: {builder: {/out.txt: /hello.txt}}
