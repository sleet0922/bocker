version: 2
mirror: china
name: bocker-packages-alpine-e2e
network: nat
stages:
  - from: alpine/3.21
    packages: [ca-certificates, curl]
    commands:
      - shell: |
          set -eu
          grep -F 'mirrors.tuna.tsinghua.edu.cn/alpine' /etc/apk/repositories
          curl --version > /curl-version.txt
    runtime: {autostart: false}
