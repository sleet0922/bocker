version: 2
mirror: china
name: bocker-packages-ubuntu-e2e
network: nat
stages:
  - from: ubuntu/24.04
    packages: [ca-certificates, curl]
    commands:
      - shell: |
          set -eu
          grep -R -F 'mirrors.tuna.tsinghua.edu.cn/ubuntu' /etc/apt
          curl --version > /curl-version.txt
    runtime: {autostart: false}
