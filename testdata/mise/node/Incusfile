version: 2
args:
  NODE_VERSION: "24.19.0"
mirror: china
name: bocker-mise-node-e2e
network: nat
stages:
  - name: builder
    from: debian/13
    tools: {node: "${NODE_VERSION}"}
    workdir: /src
    files: {/src/: [package.json, app.js, app.test.js]}
    commands:
      - shell: |
          set -eu
          mkdir -p /out
          npm test
          node app.js > /out/result.json
          node --version > /out/version.txt
  - from: debian/13
    workdir: /opt/bocker-mise-test
    artifacts: {builder: {/out/result.json: ./, /out/version.txt: ./}}
    commands:
      - shell: |
          set -eu
          grep -Fx 'v24.19.0' version.txt
          grep -F '"language":"node"' result.json
          test ! -e /opt/bocker-mise
    runtime: {autostart: false}
