ARG RUST_VERSION=1.89.0
MIRROR china

FROM debian/13
NAME bocker-mise-rust-e2e
NETWORK nat

TEMP builder
PKG build-essential ca-certificates curl git
MISE rust ${RUST_VERSION}
WORKDIR /src
COPY Cargo.toml ./Cargo.toml
COPY src ./src
RUN test "$CARGO_REGISTRIES_CRATES_IO_INDEX" = sparse+https://rsproxy.cn/index/ && \
    cargo test --release && \
    cargo build --release && \
    mkdir -p /out && \
    cp target/release/bocker-mise-rust-e2e /out/app && \
    rustc --version > /out/version.txt
END

WORKDIR /opt/bocker-mise-test
COPY --from=builder /out/app /usr/local/bin/bocker-mise-rust-e2e
COPY --from=builder /out/version.txt ./version.txt
RUN test "$(/usr/local/bin/bocker-mise-rust-e2e)" = \
      '{"language":"rust","version":"1.89.0","checksum":28}' && \
    grep -F 'rustc 1.89.0 ' version.txt && \
    test ! -e /opt/bocker-mise
AUTOSTART off
