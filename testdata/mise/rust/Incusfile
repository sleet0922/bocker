version: 2
args:
  RUST_VERSION: "1.89.0"
mirror: china
name: bocker-mise-rust-e2e
network: nat
stages:
  - name: builder
    from: debian/13
    packages: [build-essential, ca-certificates, curl, git]
    tools: {rust: "${RUST_VERSION}"}
    workdir: /src
    files: {/src/: [Cargo.toml], /src/src/: [src]}
    commands:
      - shell: |
          set -eu
          test "$CARGO_REGISTRIES_CRATES_IO_INDEX" = sparse+https://rsproxy.cn/index/
          cargo test --release
          cargo build --release
          mkdir -p /out
          cp target/release/bocker-mise-rust-e2e /out/app
          rustc --version > /out/version.txt
  - from: debian/13
    workdir: /opt/bocker-mise-test
    artifacts: {builder: {/out/app: /usr/local/bin/bocker-mise-rust-e2e, /out/version.txt: ./}}
    commands:
      - shell: |
          set -eu
          test "$(/usr/local/bin/bocker-mise-rust-e2e)" = '{"language":"rust","version":"1.89.0","checksum":28}'
          grep -F 'rustc 1.89.0 ' version.txt
          test ! -e /opt/bocker-mise
    runtime: {autostart: false}
