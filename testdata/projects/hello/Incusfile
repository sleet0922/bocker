ARG BASE_IMAGE=alpine/3.24
MIRROR china
NAME bocker-hello-project
NETWORK nat

FROM ${BASE_IMAGE} AS builder
WORKDIR /src
COPY hello.sh message.txt ./
RUN chmod +x hello.sh && ./hello.sh "$(cat message.txt)" > /out.txt

FROM alpine/3.24
COPY --from=builder /out.txt /hello.txt
CMD ["/bin/sh", "-c", "cat /hello.txt"]
