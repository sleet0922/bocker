ARG PYTHON_VERSION=3.13.7
ARG DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn

FROM debian/13
NAME bocker-asdf-python-e2e
NETWORK nat

TEMP builder
RUN rm -f /etc/apt/sources.list.d/debian.sources && \
    printf '%s\n' \
      "deb $DEBIAN_MIRROR/debian trixie main" \
      "deb $DEBIAN_MIRROR/debian trixie-updates main" \
      "deb $DEBIAN_MIRROR/debian-security trixie-security main" \
      > /etc/apt/sources.list && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      git \
      libbz2-dev \
      libffi-dev \
      liblzma-dev \
      libreadline-dev \
      libsqlite3-dev \
      libssl-dev \
      xz-utils \
      zlib1g-dev
ASDF python ${PYTHON_VERSION}
WORKDIR /src
COPY app.py ./app.py
COPY test_app.py ./test_app.py
RUN mkdir -p /out && \
    python -m unittest -v && \
    python -m compileall -q . && \
    python app.py > /out/result.json && \
    python --version > /out/version.txt
END

WORKDIR /opt/bocker-asdf-test
COPY --from=builder /out/result.json ./result.json
COPY --from=builder /out/version.txt ./version.txt
RUN grep -Fx 'Python 3.13.7' version.txt && \
    grep -F '"language": "python"' result.json && \
    test ! -e /opt/bocker-asdf
AUTOSTART off
