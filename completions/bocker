_bocker_completion() {
    local cur prev resource action options
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev=""
    if (( COMP_CWORD > 0 )); then
        prev="${COMP_WORDS[COMP_CWORD-1]}"
    fi

    case "$prev" in
        --network)
            mapfile -t COMPREPLY < <(compgen -W "nat bridge" -- "$cur")
            return
            ;;
        --name|--build-arg)
            return
            ;;
    esac

    if (( COMP_CWORD == 1 )); then
        mapfile -t COMPREPLY < <(compgen -W "template image container help version" -- "$cur")
        return
    fi

    resource="${COMP_WORDS[1]}"
    if (( COMP_CWORD == 2 )); then
        case "$resource" in
            template) options="list install" ;;
            image) options="build list run remove" ;;
            container) options="list shell exec start stop restart set export import remove" ;;
            *) return ;;
        esac
        mapfile -t COMPREPLY < <(compgen -W "$options" -- "$cur")
        return
    fi

    action="${COMP_WORDS[2]}"

    # Nested completion for container settings. The mount subcommands accept
    # source/target paths followed by an optional ro/rw mode.
    if [[ "$resource:$action" == "container:set" ]]; then
        if (( COMP_CWORD == 4 )); then
            options="domain port mount autostart network"
            mapfile -t COMPREPLY < <(compgen -W "$options" -- "$cur")
            return
        fi
        if (( COMP_CWORD >= 5 )) && [[ "${COMP_WORDS[4],,}" == "mount" ]]; then
            case "${COMP_WORDS[5],,}" in
                "")
                    options="list add update rm remove"
                    mapfile -t COMPREPLY < <(compgen -W "$options" -- "$cur")
                    return
                    ;;
                list)
                    if (( COMP_CWORD == 6 )); then
                        options="--json"
                        mapfile -t COMPREPLY < <(compgen -W "$options" -- "$cur")
                    fi
                    return
                    ;;
                add)
                    if (( COMP_CWORD == 6 || COMP_CWORD == 7 )); then
                        mapfile -t COMPREPLY < <(compgen -f -- "$cur")
                        return
                    fi
                    if (( COMP_CWORD == 8 )); then
                        options="ro rw"
                        mapfile -t COMPREPLY < <(compgen -W "$options" -- "$cur")
                        return
                    fi
                    ;;
                update)
                    if (( COMP_CWORD == 7 )); then
                        options="ro rw"
                        mapfile -t COMPREPLY < <(compgen -W "$options" -- "$cur")
                        return
                    fi
                    ;;
            esac
            return
        fi
        return
    fi

    case "$resource:$action" in
        template:list|image:list|container:list)
            options="--json"
            ;;
        template:install|image:run)
            options="--name --network"
            ;;
        image:build)
            options="--name --network --build-arg --help"
            ;;
        container:import)
            options="--network"
            ;;
        *)
            options=""
            ;;
    esac

    if [[ "$cur" == -* ]]; then
        mapfile -t COMPREPLY < <(compgen -W "$options" -- "$cur")
        return
    fi

    case "$resource:$action" in
        image:build|container:import)
            mapfile -t COMPREPLY < <(compgen -f -- "$cur")
            ;;
    esac
}

complete -F _bocker_completion bocker
