FROM alpine/3.24 AS builder
NETWORK nat
ENV npm_config_registry=https://registry.npmmirror.com
ENV npm_config_fund=false
ENV npm_config_audit=false
WORKDIR /src
RUN sed -i 's#https://dl-cdn.alpinelinux.org/alpine#https://mirrors.aliyun.com/alpine#g' /etc/apk/repositories && apk add --no-cache nodejs npm
COPY package.json .
COPY package-lock.json .
RUN npm ci --omit=dev --registry=https://registry.npmmirror.com
COPY server.js .
COPY config.json .

FROM alpine/3.24
NETWORK nat
NAME bocker-node-api
ENV APP_CONFIG=/etc/node-api/config.json
ENV APP_ENV=production
ENV APP_MESSAGE=node-api-ready
ENV NODE_ENV=production
RUN sed -i 's#https://dl-cdn.alpinelinux.org/alpine#https://mirrors.aliyun.com/alpine#g' /etc/apk/repositories && apk add --no-cache nodejs openrc
WORKDIR /opt/node-api
COPY --from=builder /src/node_modules /opt/node-api/node_modules
COPY --from=builder /src/server.js /opt/node-api/server.js
COPY config.json /etc/node-api/config.json
COPY node-api.init /etc/init.d/node-api
RUN chmod +x /etc/init.d/node-api && rc-update add node-api default
EXPOSE 3000/tcp
DOMAIN node-api.test
AUTOSTART on
