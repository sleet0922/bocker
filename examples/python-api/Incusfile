FROM alpine/3.24 AS builder
NETWORK nat
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /src
RUN sed -i 's#https://dl-cdn.alpinelinux.org/alpine#https://mirrors.aliyun.com/alpine#g' /etc/apk/repositories && apk add --no-cache python3 py3-pip python3-dev
RUN python3 -m venv /opt/venv
COPY requirements.txt .
RUN /opt/venv/bin/pip install --no-cache-dir --index-url https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt

FROM alpine/3.24
NETWORK nat
NAME bocker-python-api
ENV APP_CONFIG=/etc/python-api/config.toml
ENV APP_ENV=production
ENV APP_MESSAGE=python-api-ready
ENV PYTHONUNBUFFERED=1
RUN sed -i 's#https://dl-cdn.alpinelinux.org/alpine#https://mirrors.aliyun.com/alpine#g' /etc/apk/repositories && apk add --no-cache python3 openrc
WORKDIR /opt/python-api
COPY --from=builder /opt/venv /opt/venv
COPY app.py /opt/python-api/app.py
COPY config.toml /etc/python-api/config.toml
COPY python-api.init /etc/init.d/python-api
RUN chmod +x /etc/init.d/python-api && rc-update add python-api default
EXPOSE 8000/tcp
DOMAIN python-api.test
AUTOSTART on
